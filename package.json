{
  "name": "my-ramadan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "ESBUILD_BINARY_PATH=/tmp/esbuild node node_modules/vite/bin/vite.js",
    "build": "ESBUILD_BINARY_PATH=/tmp/esbuild node node_modules/vite/bin/vite.js build",
    "build:watch": "vite build --watch",
    "preview": "vite preview --host 0.0.0.0 --port 5500",
    "deploy": "npm run build",
    "start": "vite build && vite preview --host 0.0.0.0 --port 5500",
    "postinstall": "cp node_modules/@esbuild/linux-x64/bin/esbuild /tmp/esbuild && chmod +x /tmp/esbuild"
  },
  "dependencies": {
    "@esbuild/linux-x64": "^0.27.3",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.2.0",
    "esbuild": "^0.27.3",
    "framer-motion": "^12.34.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.1"
  }
}
